# =========================================================
# Izah POS — Environment Variables
# Copy this file to .env and fill in the values.
# Docs: https://github.com/izah/izah-pos/blob/main/docs/configuration.md
# =========================================================

# Runtime PostgreSQL connection (Supabase transaction pooler recommended)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migration connection (Supabase session pooler or direct connection)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Better Auth secret — generate with: openssl rand -base64 48
# Must be at least 32 characters. CHANGE THIS IN PRODUCTION.
BETTER_AUTH_SECRET="change_me_generate_a_random_secret_min_32_chars"

# The canonical URL this app is accessed from (must match browser origin)
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL exposed to the browser
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated list of additional trusted origins (for production / multi-IP)
# BETTER_AUTH_TRUSTED_ORIGINS="https://pos.yourshop.com"

# Supabase Storage (server-only; never prefix the service-role key with NEXT_PUBLIC_)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace_with_supabase_service_role_key"
SUPABASE_STORAGE_BUCKET="product-images"

# Node environment
NODE_ENV="development"
