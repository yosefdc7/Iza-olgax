# =========================================================
# Izah POS — Environment Variables
# Copy this file to .env and fill in the values.
# Docs: https://github.com/izah/izah-pos/blob/main/docs/configuration.md
# =========================================================

# Database connection string (Prisma + Better Auth)
# - Local Development: "file:./dev.db"
# - Cloudflare D1: Automatically bound via env.DB in wrangler.jsonc
# - Remote PostgreSQL: "postgresql://user:pass@host:5432/db"
DATABASE_URL="file:./dev.db"

# Better Auth secret — generate with: openssl rand -base64 48
# Must be at least 32 characters. CHANGE THIS IN PRODUCTION.
BETTER_AUTH_SECRET="change_me_generate_a_random_secret_min_32_chars"

# The canonical URL this app is accessed from (must match browser origin)
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL exposed to the browser
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated list of additional trusted origins (for production / multi-IP)
# BETTER_AUTH_TRUSTED_ORIGINS="https://pos.yourshop.com"

# Cloudflare R2 Object Storage (Optional: if storing images on Cloudflare R2)
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="izah-pos-images"
# R2_PUBLIC_URL="https://media.izahpos.com"

# Node environment
NODE_ENV="development"
