{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izah-pos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "izah-pos-db",
      "database_id": "9090fd62-2cee-4155-9418-391b453a183f"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://izah-pos.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://izah-pos.workers.dev"
  }
}
